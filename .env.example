# Optional. Paste only the token supplied by the search engine, not the full HTML tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only Slack incoming webhook. Never prefix with NEXT_PUBLIC_.
SLACK_WEBHOOK_URL=

# Leave unset for automatic behavior: production is indexable, development and
# Vercel preview deployments are not. For other staging hosts, explicitly set false.
# SITE_INDEXABLE=false
# Set SITE_INDEXABLE=true only on the public production deployment.
# Rebuild after changing any of these values; metadata is generated at build time.
# Vercel previews remain non-indexable even if SITE_INDEXABLE=true.
